---
import { site, partners } from '../data/site';
const initials = (name: string) =>
  name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2);
---

<section class="hero">
  <div class="container hero__grid">
    <div>
      <span class="eyebrow">Biuro rachunkowe · {site.city} i okolice</span>
      <h1>Trzy specjalistki. <em>Zero pośredników.</em> Księgowość bez błędów.</h1>
      <p class="lead">
        Tax Trio to biuro prowadzone przez trzy doświadczone księgowe, które pracują na własny rachunek. Nie zatrudniamy
        pracowników. Państwa sprawami zajmują się wyłącznie właścicielki, a każdą deklarację sprawdzają dwie pary oczu.
      </p>
      <div class="hero__actions">
        <a href="#kontakt" class="btn btn--primary">Bezpłatna wycena</a>
        <a href="#cennik" class="btn btn--ghost">Zobacz cennik</a>
      </div>
      <ul class="hero__facts">
        <li>Pełna księgowość, KPiR, ryczałt</li>
        <li>Kadry i płace</li>
        <li>Dojazd do klienta</li>
      </ul>
    </div>

    <aside class="hero__card" aria-label="Jak pracujemy">
      <div class="hero__avatars">
        {
          partners.map((p) => (
            <span class="avatar" title={p.role}>
              {initials(p.name)}
            </span>
          ))
        }
      </div>
      <p class="hero__card-title">Państwa firmę znają wszystkie trzy</p>
      <ul class="hero__checks">
        <li>Rozmawiają Państwo bezpośrednio z właścicielką</li>
        <li>Każda deklaracja sprawdzona przez drugą Wspólniczkę</li>
        <li>Urlop ani choroba nie wstrzymują Państwa księgowości</li>
        <li>Ubezpieczenie OC biura rachunkowego</li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 8vw, 100px) 0 clamp(64px, 9vw, 110px);
    background:
      radial-gradient(circle at 85% 20%, var(--gold-soft) 0, transparent 45%),
      var(--bg);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 56px;
    align-items: center;
  }
  h1 em {
    font-style: italic;
    color: var(--gold);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 32px 0 28px;
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .hero__facts li::before {
    content: '•';
    color: var(--gold);
    margin-right: 8px;
  }
  .hero__card {
    background: var(--navy);
    color: #fff;
    border-radius: 22px;
    padding: 36px;
    box-shadow: var(--shadow);
  }
  .hero__avatars {
    display: flex;
    margin-bottom: 22px;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1rem;
    background: var(--gold-soft);
    color: var(--navy);
    border: 3px solid var(--navy);
  }
  .avatar + .avatar {
    margin-left: -12px;
  }
  .avatar:nth-child(2) {
    background: var(--gold);
    color: #fff;
  }
  .hero__card-title {
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.25;
    margin-bottom: 18px;
  }
  .hero__checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    color: rgba(255, 255, 255, 0.85);
  }
  .hero__checks li {
    display: flex;
    gap: 12px;
  }
  .hero__checks li::before {
    content: '✓';
    color: var(--gold);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
