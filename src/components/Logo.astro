---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light }]} aria-label="Tax Trio – Biuro Rachunkowe">
  <span class="logo__mark" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="logo__text">
    <strong>Tax Trio</strong>
    <small>Biuro Rachunkowe</small>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--navy);
  }
  .logo--light {
    color: #fff;
  }
  .logo__mark {
    display: inline-flex;
    gap: 4px;
    align-items: flex-end;
    height: 28px;
  }
  .logo__mark i {
    width: 7px;
    border-radius: 2px;
    background: currentColor;
  }
  .logo__mark i:nth-child(1) {
    height: 14px;
  }
  .logo__mark i:nth-child(2) {
    height: 21px;
    background: var(--gold);
  }
  .logo__mark i:nth-child(3) {
    height: 28px;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__text strong {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .logo__text small {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-top: 4px;
  }
</style>
